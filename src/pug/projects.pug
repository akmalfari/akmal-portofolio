include includes/github-icon.pug
doctype html
html(lang="en")
  head
    meta(charset="utf-8")
    meta(name="viewport", content="width=device-width, initial-scale=1")
    meta(name="description", content="Software projects by Akmal Zaida.")
    meta(name="author", content="Akmal Zaida")
    title Projects | Akmal Zaida
    link(rel="icon", type="image/x-icon", href="assets/favicon.ico")
    include includes/css.pug
  body
    include includes/navbar.pug
    main.page-main
      section.site-shell
        p.eyebrow My work
        h1.page-title Projects
        .projects-grid
          article.project-tile
            .project-tile__image
              img(src="assets/maildesk_banner.png", alt="MailDesk application showcase", loading="eager")
            .project-tile__content
              .project-tile__copy
                h2 MailDesk
                p 2026 &middot; Mobile App &middot; Backend Developer
              .project-tile__actions
                a.icon-button(href="https://github.com/akmalfari/Maildesk_be", target="_blank", rel="noopener noreferrer", aria-label="View code on GitHub")
                  +github-icon
                a.icon-button(href="https://play.google.com/store/apps/details?id=com.maildesk.app", target="_blank", rel="noopener noreferrer", aria-label="View MailDesk on Google Play")
                  i.bi.bi-arrow-up-right(aria-hidden="true")
            p.project-tile__description.
              A mail management application for internal company use, featuring OCR-based document scanning,
              structured archiving with a systematic file numbering system, and a multi-level disposition
              workflow to route incoming letters through the proper chain of approval. Published on the
              Google Play Store. Built as a team project with IT PENS and AgileTeknik.
            .badge-list
              span C#
              span .NET
              span REST API
              span OCR

          article.project-tile
            .project-tile__image
              img(src="assets/Temannasi.png", alt="Temannasi storefront screenshot", loading="lazy")
            .project-tile__content
              .project-tile__copy
                h2 Temannasi
                p 2025 &middot; Web App &middot; Full-stack Developer
              .project-tile__actions
                a.icon-button(href="https://github.com/akmalfari/Temannasi", target="_blank", rel="noopener noreferrer", aria-label="View code on GitHub")
                  +github-icon
                a.icon-button(href="https://temannasi.vercel.app/", target="_blank", rel="noopener noreferrer", aria-label="Open the Temannasi website")
                  i.bi.bi-arrow-up-right(aria-hidden="true")
            p.project-tile__description.
              An online storefront for a home-based rendang business ("Mamie Ulie"), featuring a product catalog
              with category filters, customer testimonials, and a WhatsApp-based ordering system that
              auto-generates pre-filled order messages for each menu item.
            .badge-list
              span TypeScript

          article.project-tile
            .project-tile__image
              img(src="assets/sarpra_banner.png", alt="SARPRA room booking dashboard", loading="lazy")
            .project-tile__content
              .project-tile__copy
                h2 Sarpra Room Booking System
                p 2025 &middot; Web App &middot; Team Project
              .project-tile__actions
                a.icon-button(href="https://github.com/akmalfari/2026-sarpra-frontend", target="_blank", rel="noopener noreferrer", aria-label="View code on GitHub")
                  +github-icon
                a.icon-button(href="https://github.com/akmalfari/2026-sarpra-backend", target="_blank", rel="noopener noreferrer", aria-label="View Sarpra backend code")
                  i.bi.bi-server(aria-hidden="true")
            p.project-tile__description.
              A full-stack room booking management system built as part of an ASP.NET course assignment.
              It consists of a frontend, backend REST API, mobile app, infrastructure setup, and documentation,
              allowing students and staff to book and manage rooms within a campus or organization.
            .badge-list
              span React
              span Tailwind CSS
              span ASP.NET Core
              span MySQL

          article.project-tile
            .project-tile__image
              img(src="assets/apppegawai_banner.png", alt="App Pegawai employee dashboard", loading="lazy")
            .project-tile__content
              .project-tile__copy
                h2 App Pegawai
                p 2024 &middot; Web App &middot; PHP Course Project
              .project-tile__actions
                a.icon-button(href="https://github.com/akmalfari/app-pegawai", target="_blank", rel="noopener noreferrer", aria-label="View code on GitHub")
                  +github-icon
            p.project-tile__description.
              An employee management CRUD application built with Laravel as part of a PHP programming course.
              It supports adding, viewing, editing, and deleting employee records including personal details
              and employment status through a responsive interface.
            .badge-list
              span Laravel
              span MySQL
              span Bootstrap
        a.projects-more(href="https://github.com/akmalfari", target="_blank", rel="noopener noreferrer")
          span More projects on GitHub
          i.bi.bi-github(aria-hidden="true")
    include includes/footer.pug
    include includes/scripts.pug
