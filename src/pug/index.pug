doctype html
html(lang="en")
  head
    meta(charset="utf-8")
    meta(name="viewport", content="width=device-width, initial-scale=1")
    meta(name="description", content="Portfolio of Akmal Zaida, an informatics student and full-stack developer from Indonesia.")
    meta(name="author", content="Akmal Zaida")
    title Akmal Zaida | Full-stack Developer
    link(rel="icon", type="image/x-icon", href="assets/favicon.ico")
    include includes/css.pug
  body
    include includes/navbar.pug
    main
      section.hero
        .site-shell
          p.hero__hello Hi, I'm Akmal Zaida
          .hero__intro
            .hero__copy
              h1 Full-stack<br>Developer
              p.
                I transform ideas into useful digital experiences through thoughtful
                #[span.shiny-accent web] development.
            .hero__portrait(aria-hidden="true")
              img(src="assets/profile_fullbody_v4.png", alt="")
          .icon-links(aria-label="Contact and social links")
            a(href="https://github.com/akmalfari", target="_blank", rel="noopener noreferrer", aria-label="Akmal Zaida on GitHub")
              i.bi.bi-github(aria-hidden="true")
            a(href="https://www.linkedin.com/in/akmal-zaida", target="_blank", rel="noopener noreferrer", aria-label="Akmal Zaida on LinkedIn")
              i.bi.bi-linkedin(aria-hidden="true")
            a(href="mailto:akmalfari1789@gmail.com", aria-label="Email Akmal Zaida")
              i.bi.bi-envelope(aria-hidden="true")

          .tech-marquee(aria-label="Technologies I use")
            .tech-marquee__track
              each duplicate in [0, 1]
                .tech-marquee__group(aria-hidden=duplicate === 1 ? "true" : "false")
                  span #[i.bi.bi-filetype-html(aria-hidden="true")] HTML
                  span #[i.bi.bi-filetype-css(aria-hidden="true")] CSS
                  span #[i.bi.bi-filetype-js(aria-hidden="true")] JavaScript
                  span #[i.bi.bi-filetype-php(aria-hidden="true")] PHP
                  span #[i.bi.bi-bootstrap(aria-hidden="true")] Bootstrap
                  span #[i.bi.bi-database(aria-hidden="true")] MySQL
                  span #[i.bi.bi-git(aria-hidden="true")] Git
                  span #[i.bi.bi-code-square(aria-hidden="true")] C#

          .home-detail
            .home-about
              p.eyebrow About me
              h2 Building practical software with clean foundations.
              p.
                I'm a 4th-year Informatics Engineering student at EEPIS (Electronic Engineering
                Polytechnic Institute of Surabaya), currently pursuing an Applied Bachelor's Degree (D4).
                I have hands-on experience building REST APIs using PHP and Laravel, gained through an
                internship as a Backend Developer at PT Otak Kanan. I enjoy solving backend problems,
                designing clean APIs, and continuously learning new technologies to build better applications.
            .skills-accordion
              h2 What I do
              details.glass-card
                summary
                  span #[i.bi.bi-window(aria-hidden="true")] Web Development
                  i.bi.bi-chevron-down(aria-hidden="true")
                ul
                  li Responsive websites and web applications
                  li Frontend development with JavaScript, Vue, and React
              details.glass-card
                summary
                  span #[i.bi.bi-server(aria-hidden="true")] Backend Development
                  i.bi.bi-chevron-down(aria-hidden="true")
                ul
                  li REST APIs with PHP, Laravel, and C#
                  li Relational database-backed applications
              details.glass-card
                summary
                  span #[i.bi.bi-phone(aria-hidden="true")] Full-stack Projects
                  i.bi.bi-chevron-down(aria-hidden="true")
                ul
                  li End-to-end web application development
                  li Integration between frontend, API, and database
    include includes/footer.pug
    include includes/scripts.pug
