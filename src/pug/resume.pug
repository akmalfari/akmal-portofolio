doctype html
html(lang="en")
  head
    meta(charset="utf-8")
    meta(name="viewport", content="width=device-width, initial-scale=1, shrink-to-fit=no")
    meta(name="description", content="")
    meta(name="author", content="")
    title Akmal-Portofolio
    link(rel="icon", type="image/x-icon", href="assets/favicon.ico")
    link(rel="preconnect", href="https://fonts.googleapis.com")
    link(rel="preconnect", href="https://fonts.gstatic.com", crossorigin)
    link(href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@100;200;300;400;500;600;700;800;900&display=swap", rel="stylesheet")
    link(href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.1/font/bootstrap-icons.css", rel="stylesheet")
    link(href="css/styles.css", rel="stylesheet")
  body.d-flex.flex-column.h-100.bg-light
    main.flex-shrink-0
      nav.navbar.navbar-expand-lg.navbar-light.bg-white.py-3
        .container.px-5
          a.navbar-brand(href="index.html")
            span.fw-bolder.text-primary Akmal Zaida
          button.navbar-toggler(type="button", data-bs-toggle="collapse", data-bs-target="#navbarSupportedContent", aria-controls="navbarSupportedContent", aria-expanded="false", aria-label="Toggle navigation")
            span.navbar-toggler-icon
          #navbarSupportedContent.collapse.navbar-collapse
            ul.navbar-nav.ms-auto.mb-2.mb-lg-0.small.fw-bolder
              li.nav-item
                a.nav-link(href="index.html") Home
              li.nav-item
                a.nav-link(href="resume.html") Resume
              li.nav-item
                a.nav-link(href="projects.html") Projects
              li.nav-item
                a.nav-link(href="contact.html") Contact

      .container.px-5.my-5
        .text-center.mb-5
          h1.display-5.fw-bolder.mb-0
            span.text-gradient.d-inline Resume
        .row.gx-5.justify-content-center
          .col-lg-11.col-xl-9.col-xxl-8

            //- Experience Section
            section
              .d-flex.align-items-center.justify-content-between.mb-4
                h2.text-primary.fw-bolder.mb-0 Work Experience
                a.btn.btn-primary.px-4.py-3(href="assets/Akmal_Zaida_Fari_CV.pdf", target="_blank")
                  .d-inline-block.bi.bi-download.me-2
                  | Download Resume

              //- Experience Card 1
              .card.border-0.rounded-4.mb-5.experience-card
                .card-body.p-5
                  .d-flex.justify-content-between.align-items-start.flex-wrap.mb-1
                    .fw-bolder.fs-5 Backend Dev
                    span.experience-date-badge Nov 2023 &ndash; April 2024
                  .text-primary.fw-semibold PT Otak Kanan
                  .small.text-muted.mb-3
                    i.bi.bi-geo-alt.me-1
                    | Surabaya, Indonesia
                  p.mb-3 Completed an internship as a Backend Developer, focused on building REST APIs for the company's internal applications.
                  ul.mb-3.ps-3
                    li Designed and developed REST APIs using PHP (Laravel) for various application modules.
                    li Created API endpoint documentation to make it easy for the frontend team to use.
                  .d-flex.flex-wrap.gap-2.mb-3
                    span.badge.tech-badge PHP
                    span.badge.tech-badge Laravel
                  a.btn.btn-outline-primary.btn-sm.px-3.py-2.rounded-pill(href="assets/sertifikat.magang.pdf", target="_blank")
                    i.bi.bi-award.me-2
                    | View Internship Certificate
              //- /Experience Card 1

            .pb-3

            //- Education Section
            section
              h2.text-secondary.fw-bolder.mb-4 Education

              //- Education Card 1
              .card.border-0.rounded-4.mb-5.education-card
                .card-body.p-5
                  .d-flex.justify-content-between.align-items-start.flex-wrap.mb-1
                    .fw-bolder.fs-5 Electronic Engineering Polytechnic Institute of Surabaya
                    span.education-date-badge 2024 - Present
                  .text-secondary.fw-semibold Surabaya, Indonesia
                  .fst-italic.small.text-muted.mb-3 Applied Bachelor's Degree (D4), Major in Informatics Engineering
                  p.mb-0 Currently pursuing a D4 degree in Informatics Engineering, building a strong foundation in software development, databases, and web-based systems.

              //- Education Card 2
              .card.border-0.rounded-4.mb-5.education-card
                .card-body.p-5
                  .d-flex.justify-content-between.align-items-start.flex-wrap.mb-1
                    .fw-bolder.fs-5 SMK Telkom Malang
                    span.education-date-badge 2021 - 2024
                  .text-secondary.fw-semibold Malang, Indonesia
                  .fst-italic.small.text-muted.mb-3 Software Engineering (RPL - Rekayasa Perangkat Lunak)
                  p.mb-0 Graduated from the Software Engineering program with a competency certificate in Web Application Development and Laravel.

            //- Organizational Experience Section
            section
              h2.text-primary.fw-bolder.mb-4 Organizational Experience

              //- Org Card 1
              .card.border-0.rounded-4.mb-5.experience-card
                .card-body.p-5
                  .d-flex.justify-content-between.align-items-start.flex-wrap.mb-1
                    .fw-bolder.fs-5 Junior Staff, PSDM Division
                    span.experience-date-badge  present
                  .text-primary.fw-semibold Informatics Engineering Student Association (HIMIT)
                  .small.text-muted.mb-3
                    i.bi.bi-geo-alt.me-1
                    | Surabaya, Indonesia
                  p.mb-0 Responsible for managing HIMIT's overall student human resources and leading cadre development programs to prepare future generations of the organization.

              //- Certifications Card
              .card.shadow.border-0.rounded-4.mb-5
                .card-body.p-5
                  .d-flex.align-items-center.mb-4
                    .feature.bg-primary.bg-gradient-primary-to-secondary.text-white.rounded-3.me-3
                      i.bi.bi-patch-check
                    h3.fw-bolder.mb-0
                      span.text-gradient.d-inline Certifications

                  //- Certificate item 1
                  .d-flex.justify-content-between.align-items-center.bg-light.rounded-4.p-3.mb-3.flex-wrap.gap-2
                    div
                      .fw-bolder Web Application Development
                      .small.text-muted SMK Telkom Malang &middot; RPL
                    a.btn.btn-outline-primary.btn-sm.px-3.py-2.rounded-pill(href="assets/RPL WEB APPS (1).pdf", target="_blank")
                      i.bi.bi-award.me-2
                      | View Certificate

                  //- Certificate item 2
                  .d-flex.justify-content-between.align-items-center.bg-light.rounded-4.p-3.mb-3.flex-wrap.gap-2
                    div
                      .fw-bolder Laravel Framework
                      .small.text-muted DOT Indonesia &middot; Laravel
                    a.btn.btn-outline-primary.btn-sm.px-3.py-2.rounded-pill(href="assets/Certificate of Competency - AKMAL ZAIDA FARI (1).pdf", target="_blank")
                      i.bi.bi-award.me-2
                      | View Certificate

                  //- Certificate item 3
                  .d-flex.justify-content-between.align-items-center.bg-light.rounded-4.p-3.flex-wrap.gap-2
                    div
                      .fw-bolder Backend Internship
                      .small.text-muted PT Otak Kanan
                    a.btn.btn-outline-primary.btn-sm.px-3.py-2.rounded-pill(href="assets/sertifikat.magang.pdf", target="_blank")
                      i.bi.bi-award.me-2
                      | View Certificate

              .pb-5

              //- Skills Section
              section
                //- Skillset Card
                .card.shadow.border-0.rounded-4.mb-5
                  .card-body.p-5
                    //- Professional skills list
                    .mb-5
                      .d-flex.align-items-center.mb-4
                        .feature.bg-primary.bg-gradient-primary-to-secondary.text-white.rounded-3.me-3
                          i.bi.bi-tools
                        h3.fw-bolder.mb-0
                          span.text-gradient.d-inline Professional Skills
                      .row.row-cols-1.row-cols-md-3.mb-4
                        .col.mb-4.mb-md-0
                          .d-flex.align-items-center.bg-light.rounded-4.p-3.h-100 Frontend Developer
                        .col.mb-4.mb-md-0
                          .d-flex.align-items-center.bg-light.rounded-4.p-3.h-100 Backend Developer
                        .col
                          .d-flex.align-items-center.bg-light.rounded-4.p-3.h-100 Web Development

                    //- Languages list
                    .mb-0
                      .d-flex.align-items-center.mb-4
                        .feature.bg-primary.bg-gradient-primary-to-secondary.text-white.rounded-3.me-3
                          i.bi.bi-code-slash
                        h3.fw-bolder.mb-0
                          span.text-gradient.d-inline Languages
                      .row.row-cols-1.row-cols-md-3.g-4
                        .col
                          .d-flex.align-items-center.bg-light.rounded-4.p-3.h-100 HTML
                        .col
                          .d-flex.align-items-center.bg-light.rounded-4.p-3.h-100 CSS
                        .col
                          .d-flex.align-items-center.bg-light.rounded-4.p-3.h-100 JavaScript
                        .col
                          .d-flex.align-items-center.bg-light.rounded-4.p-3.h-100 Laravel
                        .col
                          .d-flex.align-items-center.bg-light.rounded-4.p-3.h-100 Vue.JS
                        .col
                          .d-flex.align-items-center.bg-light.rounded-4.p-3.h-100 React.JS
                        .col
                          .d-flex.align-items-center.bg-light.rounded-4.p-3.h-100 Node.JS

    footer.bg-white.py-4.mt-auto
      .container.px-5
        .row.align-items-center.justify-content-between.flex-column.flex-sm-row
          .col-auto
            .small.m-0 Copyright &copy; Akmal Zaida
          .col-auto
            a.small(href="#!") Privacy
            span.mx-1 &middot;
            a.small(href="#!") Terms
            span.mx-1 &middot;
            a.small(href="#!") Contact
    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js")
    script(src="js/scripts.js")
