doctype html
html(lang="en")
  head
    meta(charset="utf-8")
    meta(name="viewport", content="width=device-width, initial-scale=1")
    meta(name="description", content="Experience, education, certifications, and skills of Akmal Zaida.")
    meta(name="author", content="Akmal Zaida")
    title Resume | Akmal Zaida
    link(rel="icon", type="image/x-icon", href="assets/favicon.ico")
    include includes/css.pug
  body
    include includes/navbar.pug
    main.page-main
      .site-shell.resume-page
        .resume-heading
          div
            p.eyebrow Background
            h1.page-title Resume
          a.primary-link(href="assets/Akmal_Zaida_Fari_CV.pdf", target="_blank")
            i.bi.bi-download(aria-hidden="true")
            | Download Resume

        section.resume-section
          h2 Work Experience
          article.resume-card.glass-card
            .resume-card__head
              div
                h3 Backend Dev
                p PT Otak Kanan
              time.date-pill Nov 2023 - April 2024
            p.resume-card__meta #[i.bi.bi-geo-alt(aria-hidden="true")] Surabaya, Indonesia
            p Completed an internship as a Backend Developer, focused on building REST APIs for the company's internal applications.
            ul
              li Designed and developed REST APIs using PHP (Laravel) for various application modules.
              li Created API endpoint documentation to make it easy for the frontend team to use.
            .badge-list
              span PHP
              span Laravel
            a.text-link(href="assets/sertifikat.magang.pdf", target="_blank") View Internship Certificate #[i.bi.bi-arrow-up-right(aria-hidden="true")]

        section.resume-section
          h2 Education
          .resume-list
            article.resume-card.glass-card
              .resume-card__head
                div
                  h3 Electronic Engineering Polytechnic Institute of Surabaya
                  p Surabaya, Indonesia
                time.date-pill 2024 - Present
              p.resume-card__meta Applied Bachelor's Degree (D4), Major in Informatics Engineering
              p Currently pursuing a D4 degree in Informatics Engineering, building a strong foundation in software development, databases, and web-based systems.
            article.resume-card.glass-card
              .resume-card__head
                div
                  h3 SMK Telkom Malang
                  p Malang, Indonesia
                time.date-pill 2021 - 2024
              p.resume-card__meta Software Engineering (RPL - Rekayasa Perangkat Lunak)
              p Graduated from the Software Engineering program with a competency certificate in Web Application Development and Laravel.

        section.resume-section
          h2 Organizational Experience
          article.resume-card.glass-card
            .resume-card__head
              div
                h3 Junior Staff, PSDM Division
                p Informatics Engineering Student Association (HIMIT)
              time.date-pill Present
            p.resume-card__meta #[i.bi.bi-geo-alt(aria-hidden="true")] Surabaya, Indonesia
            p Responsible for managing HIMIT's overall student human resources and leading cadre development programs to prepare future generations of the organization.

        section.resume-section
          h2 Certifications
          .certificate-list.glass-card
            .certificate-item
              div
                h3 Web Application Development
                p SMK Telkom Malang &middot; RPL
              a.text-link(href="assets/RPL WEB APPS (1).pdf", target="_blank") View Certificate #[i.bi.bi-arrow-up-right(aria-hidden="true")]
            .certificate-item
              div
                h3 Laravel Framework
                p DOT Indonesia &middot; Laravel
              a.text-link(href="assets/Certificate of Competency - AKMAL ZAIDA FARI (1).pdf", target="_blank") View Certificate #[i.bi.bi-arrow-up-right(aria-hidden="true")]
            .certificate-item
              div
                h3 Backend Internship
                p PT Otak Kanan
              a.text-link(href="assets/sertifikat.magang.pdf", target="_blank") View Certificate #[i.bi.bi-arrow-up-right(aria-hidden="true")]

        section.resume-section
          h2 Skills
          .skills-card.glass-card
            div
              h3 Professional Skills
              .badge-list
                span Frontend Developer
                span Backend Developer
                span Web Development
            div
              h3 Languages &amp; Frameworks
              .badge-list
                span HTML
                span CSS
                span JavaScript
                span Laravel
                span Vue.JS
                span React.JS
                span Node.JS
    include includes/footer.pug
    include includes/scripts.pug
