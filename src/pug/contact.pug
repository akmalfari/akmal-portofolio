doctype html
html(lang="en")
  head
    meta(charset="utf-8")
    meta(name="viewport", content="width=device-width, initial-scale=1, shrink-to-fit=no")
    meta(name="description", content="")
    meta(name="author", content="")
    title Akmal-Portofolio
    link(rel="icon", type="image/x-icon", href="assets/favicon.ico")
    link(rel="preconnect", href="https://fonts.googleapis.com")
    link(rel="preconnect", href="https://fonts.gstatic.com", crossorigin)
    link(href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@100;200;300;400;500;600;700;800;900&display=swap", rel="stylesheet")
    link(href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.1/font/bootstrap-icons.css", rel="stylesheet")
    link(href="css/styles.css", rel="stylesheet")
  body.d-flex.flex-column
    main.flex-shrink-0
      nav.navbar.navbar-expand-lg.navbar-light.bg-white.py-3
        .container.px-5
          a.navbar-brand(href="index.html")
            span.fw-bolder.text-primary Akmal Zaida
          button.navbar-toggler(type="button", data-bs-toggle="collapse", data-bs-target="#navbarSupportedContent", aria-controls="navbarSupportedContent", aria-expanded="false", aria-label="Toggle navigation")
            span.navbar-toggler-icon
          #navbarSupportedContent.collapse.navbar-collapse
            ul.navbar-nav.ms-auto.mb-2.mb-lg-0.small.fw-bolder
              li.nav-item
                a.nav-link(href="index.html") Home
              li.nav-item
                a.nav-link(href="resume.html") Resume
              li.nav-item
                a.nav-link(href="projects.html") Projects
              li.nav-item
                a.nav-link(href="contact.html") Contact

      //- Page content
      section.py-5
        .container.px-5
          //- Contact form
          .bg-light.rounded-4.py-5.px-4.px-md-5
            .text-center.mb-5
              .feature.bg-primary.bg-gradient-primary-to-secondary.text-white.rounded-3.mb-3
                i.bi.bi-envelope
              h1.fw-bolder Get in touch
              p.lead.fw-normal.text-muted.mb-0 Let's work together!
            .row.gx-5.justify-content-center
              .col-lg-8.col-xl-6
                //- Form ini menggunakan FormSubmit (gratis, tanpa perlu backend sendiri)
                //- Kiriman pesan akan langsung masuk ke email di bawah ini
                form#contactForm(action="https://formsubmit.co/akmalfari1789@gmail.com", method="POST")
                  //- Judul email yang diterima
                  input(type="hidden", name="_subject", value="Pesan baru dari Portofolio!")
                  //- Matikan captcha bawaan FormSubmit
                  input(type="hidden", name="_captcha", value="false")
                  //- Format email jadi tabel rapi
                  input(type="hidden", name="_template", value="table")

                  //- Name input
                  .form-floating.mb-3
                    input#name.form-control(name="Nama", type="text", placeholder="Enter your name...", required)
                    label(for="name") Full name
                  //- Email address input
                  .form-floating.mb-3
                    input#email.form-control(name="Email", type="email", placeholder="name@example.com", required)
                    label(for="email") Email address
                  //- Phone number input
                  .form-floating.mb-3
                    input#phone.form-control(name="No Telepon", type="tel", placeholder="(123) 456-7890")
                    label(for="phone") Phone number
                  //- Message input
                  .form-floating.mb-3
                    textarea#message.form-control(name="Pesan", placeholder="Enter your message here...", style="height: 10rem", required)
                    label(for="message") Message
                  //- Submit Button
                  .d-grid
                    button#submitButton.btn.btn-primary.btn-lg(type="submit") Submit

    footer.bg-white.py-4.mt-auto
      .container.px-5
        .row.align-items-center.justify-content-between.flex-column.flex-sm-row
          .col-auto
            .small.m-0 Copyright &copy; Akmal Zaida 2026
          .col-auto
            a.small(href="#!") Privacy
            span.mx-1 &middot;
            a.small(href="#!") Terms
            span.mx-1 &middot;
            a.small(href="contact.html") Contact
    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js")
    script(src="js/scripts.js")
