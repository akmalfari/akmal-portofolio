doctype html
html(lang="en")
  head
    meta(charset="utf-8")
    meta(name="viewport", content="width=device-width, initial-scale=1")
    meta(name="description", content="Contact Akmal Zaida about software and web development projects.")
    meta(name="author", content="Akmal Zaida")
    title Contact | Akmal Zaida
    link(rel="icon", type="image/x-icon", href="assets/favicon.ico")
    include includes/css.pug
  body
    include includes/navbar.pug
    main.page-main
      section.site-shell
        p.eyebrow Let's talk
        h1.page-title Contact
        .contact-grid
          .contact-intro
            h2 Have a question or a project in mind?
            p Feel free to reach out. I am interested in building useful, maintainable digital products and collaborating on thoughtful software projects.
            .contact-location
              i.bi.bi-geo-alt(aria-hidden="true")
              div
                span Location
                strong Surabaya, Indonesia
            a.text-link(href="mailto:akmalfari1789@gmail.com") akmalfari1789@gmail.com
          .contact-form-card.glass-card
            //- FormSubmit configuration and field names are intentionally preserved.
            form#contactForm(action="https://formsubmit.co/akmalfari1789@gmail.com", method="POST", data-ajax-url="https://formsubmit.co/ajax/akmalfari1789@gmail.com")
              input(type="text", name="_honeypot", style="display: none", tabindex="-1", autocomplete="off")
              input(type="hidden", name="_subject", value="Pesan baru dari Portofolio!")
              input(type="hidden", name="_captcha", value="false")
              input(type="hidden", name="_template", value="table")
              .form-field
                label(for="name") Full name
                input#name.form-control(name="Nama", type="text", autocomplete="name", required)
              .form-field
                label(for="email") Email address
                input#email.form-control(name="Email", type="email", autocomplete="email", required)
              .form-field
                label(for="phone") Phone number
                input#phone.form-control(name="No Telepon", type="tel", autocomplete="tel")
              .form-field
                label(for="message") Message
                textarea#message.form-control(name="Pesan", rows="6", required)
              #submitSuccess.form-alert.form-alert--success.d-none(role="status")
                | Terima kasih! Pesanmu sudah terkirim ke email saya dan akan segera dibalas.
              #submitError.form-alert.form-alert--error.d-none(role="alert")
                | Maaf, pesan gagal terkirim. Silakan kirim langsung ke
                |
                a(href="mailto:akmalfari1789@gmail.com") akmalfari1789@gmail.com
                | .
              button#submitButton.contact-submit(type="submit") Submit
    include includes/footer.pug
    include includes/scripts.pug
